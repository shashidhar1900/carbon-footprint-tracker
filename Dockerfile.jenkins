FROM jenkins/jenkins:lts-jdk21

USER root

# Docker CLI (talks to the HOST's Docker daemon via the mounted socket —
# this is "Docker outside of Docker", not Docker-in-Docker, which is simpler
# and avoids nested-daemon headaches for a single-host setup like this)
RUN apt-get update && \
    apt-get install -y ca-certificates curl gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Maven (builds all 8 Spring Boot services)
RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

# Node (builds the React frontend)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

RUN usermod -aG root jenkins

USER jenkins
